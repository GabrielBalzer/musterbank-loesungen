@@ -55,6 +62,39 @@ class TransferService:
         assert transfer is not None
         return transfer
 
+    def create_idempotent(self, key: str, request: TransferRequest) -> Tuple[int, Dict[str, Any]]:
+        """Execute a request once per key and replay the stored answer afterwards."""
+        fingerprint = hashlib.sha256(json.dumps(asdict(request), sort_keys=True).encode("utf-8")).hexdigest()
+        db = self._bank.db
+        with self._bank.transaction():
+            row = db.execute(
+                "SELECT fingerprint, status, response FROM idempotency_keys WHERE key = ?", (key,)
+            ).fetchone()
+            if row is not None:
+                if row["fingerprint"] != fingerprint:
+                    raise IdempotencyConflict(key)
+                return row["status"], json.loads(row["response"])
+            status, payload = self._attempt(request)
+            db.execute(
+                "INSERT INTO idempotency_keys (key, fingerprint, status, response, created_at) VALUES (?, ?, ?, ?, ?)",
+                (key, fingerprint, status, json.dumps(payload), utc_now().strftime("%Y-%m-%dT%H:%M:%SZ")),
+            )
+        return status, payload
+
+    def _attempt(self, request: TransferRequest) -> Tuple[int, Dict[str, Any]]:
+        db = self._bank.db
+        db.execute("SAVEPOINT transfer_attempt")
+        try:
+            outcome = 201, self.create_transfer(request).to_json()
+        except AccountNotFound:
+            outcome = 404, {"error": "unknown account"}
+        except TransferRejected as exc:
+            outcome = 409, {"error": "rejected", "reason": str(exc)}
+        if outcome[0] != 201:
+            db.execute("ROLLBACK TO transfer_attempt")
+        db.execute("RELEASE transfer_attempt")
+        return outcome
+
     def get_transfer(self, transfer_id: int) -> Optional[Transfer]:
         return self._transfers.get(transfer_id)
 
