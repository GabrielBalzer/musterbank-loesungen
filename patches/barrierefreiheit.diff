diff --git a/web/static/style.css b/web/static/style.css
index 52cc8cc..a4d4910 100644
--- a/web/static/style.css
+++ b/web/static/style.css
@@ -1,33 +1,31 @@
 :root {
-  --ink: #3a4552;
-  --muted: #b4bbc2;
-  --brand: #7ab6d4;
+  --ink: #1b2430;
+  --muted: #55606e;
+  --brand: #0b4f6c;
   --paper: #ffffff;
   --band: #eef2f5;
-  --error: #f08a8a;
-  --success: #8fd0a6;
+  --error: #a4161a;
+  --success: #1b6e3c;
 }
-* { box-sizing: border-box; outline: none; }
-body { margin: 0; font: 14px/1.4 system-ui, sans-serif; color: var(--ink); background: var(--paper); }
-a { color: var(--brand); text-decoration: none; }
-.site-header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; padding: 12px 16px; background: var(--band); }
-.site-header img { cursor: pointer; }
-.menu { display: flex; flex-wrap: wrap; gap: 16px; }
-.menu-item { color: var(--brand); cursor: pointer; }
-.content { max-width: 960px; margin: 0 auto; padding: 16px; }
-.site-footer { padding: 16px; color: var(--muted); text-align: center; }
-.title { font-size: 22px; font-weight: 600; margin: 8px 0 16px; }
+* { box-sizing: border-box; }
+body { margin: 0; font: 16px/1.5 system-ui, sans-serif; color: var(--ink); background: var(--paper); }
+a { color: var(--brand); }
+a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible { outline: 3px solid var(--brand); outline-offset: 2px; }
+.skip { position: absolute; left: -999px; }
+.skip:focus { left: 8px; top: 8px; background: var(--paper); padding: 8px; }
+header.site { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; padding: 12px 16px; background: var(--band); }
+nav ul { display: flex; flex-wrap: wrap; gap: 16px; list-style: none; margin: 0; padding: 0; }
+main { max-width: 960px; margin: 0 auto; padding: 16px; }
+footer.site { padding: 16px; color: var(--muted); text-align: center; }
 table { width: 100%; border-collapse: collapse; margin: 16px 0; }
-td { padding: 8px; border-bottom: 1px solid #e5e9ed; color: #98a1aa; }
-.head td { color: var(--muted); font-weight: 600; }
-.row { cursor: pointer; }
-.row:hover { background: var(--band); }
+caption { text-align: left; font-weight: 600; padding-bottom: 4px; }
+th, td { padding: 8px; border-bottom: 1px solid #c8d0d8; text-align: left; }
 .num { text-align: right; white-space: nowrap; }
 .stack { display: grid; gap: 8px; max-width: 420px; }
 .inline { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
-input, select { padding: 8px; font: inherit; border: 1px solid #e5e9ed; border-radius: 4px; }
-input::placeholder { color: #c5ccd2; }
-.btn { display: inline-block; padding: 8px 16px; color: #ffffff; background: var(--brand); border-radius: 4px; cursor: pointer; text-align: center; }
-.error { color: var(--error); }
-.success { color: var(--success); }
+input, select { padding: 8px; font: inherit; border: 1px solid var(--muted); border-radius: 4px; }
+button { padding: 8px 16px; font: inherit; color: #ffffff; background: var(--brand); border: 0; border-radius: 4px; cursor: pointer; }
+button.linklike { padding: 0; color: var(--brand); background: none; text-decoration: underline; }
+.error { color: var(--error); font-weight: 600; }
+.success { color: var(--success); font-weight: 600; }
 .letter { white-space: pre-wrap; font: inherit; }
